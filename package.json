{
  "name": "@accelist/nextjs-starter",
  "version": "0.1.0",
  "description": "Next.js project starter template for PT. Accelist Lentera Indonesia",
  "author": "Ryan Elian",
  "homepage": "https://github.com/accelist/nextjs-starter#readme",
  "bugs": "https://github.com/accelist/nextjs-starter/issues",
  "license": "Apache-2.0",
  "main": "index.js",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "dev:nextjs": "next dev",
    "typescript": "tsc -w --pretty --preserveWatchOutput",
    "lint": "eslint .",
    "dev": "concurrently \"npm:prepare\" \"npm:typescript\" \"npm:dev:nextjs\"",
    "build": "next build",
    "start": "next start -p 80",
    "debug": "cross-env NODE_OPTIONS=--inspect next dev",
    "prepare": "husky",
    "pre-commit-check": "tsc && eslint ."
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "concurrently": "10.0.4",
    "cross-env": "10.1.0",
    "eslint": "10.8.1",
    "eslint-config-next": "16.3.1",
    "husky": "9.1.7",
    "postcss": "8.5.26",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@bprogress/core": "1.3.4",
    "@bprogress/next": "3.2.12",
    "@fortawesome/fontawesome-svg-core": "7.3.1",
    "@fortawesome/free-solid-svg-icons": "7.3.1",
    "@fortawesome/react-fontawesome": "3.5.0",
    "@hookform/error-message": "2.0.1",
    "@hookform/resolvers": "5.8.0",
    "antd": "6.6.0",
    "dayjs": "1.11.21",
    "http-proxy-3": "1.23.3",
    "jotai": "2.20.2",
    "next": "16.3.1",
    "next-auth": "4.24.15",
    "openid-client": "6.8.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "7.85.0",
    "swr": "2.5.1",
    "zod": "4.4.3"
  }
}
